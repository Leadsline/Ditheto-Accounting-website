{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "CLERK_PRODUCTION_AUTH_EXPECTED=1 pnpm run build:vercel",
  "outputDirectory": "artifacts/ditheto-accountants/dist/public",
  "framework": "vite",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/__clerk/(.*)",
      "dest": "/api/[...path]"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path]"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
