# Frontend (embedded at build time)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=/api/__clerk

# API runtime
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
SESSION_SECRET=
LOG_LEVEL=info

# Portable Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=private-documents
SUPABASE_PUBLIC_BUCKET=public-assets

# Replit Object Storage paths are only needed when running the legacy Replit
# storage provider locally.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=